# Copy to .env (git-ignored). Everything runs locally; no API keys needed.
# Local VLM (Hugging Face model id). Weights (~4.5 GB) download once to ~/.cache/huggingface
VLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
VLM_DTYPE=bfloat16
# Max image pixels sent to the VLM (lower = faster on CPU, less detail)
VLM_MAX_PIXELS=351232
VLM_MAX_NEW_TOKENS=256
# server (default, more accurate) | mobile (about 2x faster, less accurate)
OCR_MODEL_SIZE=server
# VLM_DEVICE=cpu   # or cuda; default picks cuda if available
OCR_LANG=en
# oneDNN crashes in paddlepaddle 3.3; keep 0 unless you upgrade paddle
OCR_ENABLE_MKLDNN=0
